# Public source allowlist. New root entries need an explicit review before upload.
/*
!/.gitattributes
!/.gitignore
!/README.md
!/manifest.json
!/package.json
!/background/
!/content/
!/icons/
!/popup/
!/shared/
!/tests/
!/tools/

# Local operational context, design experiments and generated distributions.
/AGENTS.md
/.pi/
/design/
/dist/
/web-ext-artifacts/
/.playwright-cli/

# Dependencies, virtual environments, caches and test output (at any depth).
node_modules/
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
coverage/
playwright-report/
test-results/
*.log
*.pid
*.tmp
*.temp
*.bak
*.orig
*.rej
*.xpi
*.zip

# Local editor/OS files.
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini
*~
*.swp
*.swo

# Local credentials/configuration. Ignore rules are not a secret scanner.
.env
.env.*
*.env
.npmrc
.pypirc
.netrc
.aws/
.ssh/
secrets/
credentials/
secrets.*
credentials.*
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*
